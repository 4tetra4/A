{
  "manifest_version": 3,
  "name": "AirbXb - Power Tools",
  "short_name": "AirbXb",
  "description": "The missing Airbnb features: Hide • Shortlist • Organise • Compare • Super Search (600 amenities)",
  "version": "1.4142",
  "action": {
    "default_title": "AirbXb",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "activeTab", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.airbnb.com/*",
    "https://*.airbnb.co.uk/*",
    "https://*.airbnb.ca/*",
    "https://*.airbnb.fr/*",
    "https://*.airbnb.de/*",
    "https://*.airbnb.es/*",
    "https://*.airbnb.it/*",
    "https://*.airbnb.com.au/*",
    "https://*.airbnb.co.nz/*",
    "https://*.airbnb.com.sg/*",
    "https://*.airbnb.co.kr/*",
    "https://*.airbnb.co.jp/*",
    "https://*.airbnb.com.br/*",
    "https://*.airbnb.com.mx/*",
    "https://*.airbnb.ie/*",
    "https://*.airbnb.nl/*",
    "https://*.airbnb.com.hk/*",
    "https://*.airbnb.in/*",
    "https://*.airbnb.at/*",
    "https://*.airbnb.hu/*",
    "https://*.airbnb.cz/*",
    "https://*.airbnb.ch/*",
    "https://*.airbnb.pl/*",
    "https://*.airbnb.no/*",
    "https://*.airbnb.dk/*",
    "https://*.airbnb.pt/*",
    "https://*.airbnb.be/*",
    "https://*.airbnb.co.in/*",
    "https://*.airbnb.co.id/*",
    "https://*.airbnb.se/*",
    "https://*.airbnb.fi/*",
    "https://*.airbnb.co.za/*",
    "https://*.airbnb.lt/*",
    "https://*.airbnb.lv/*",
    "https://*.airbnb.rs/*",
    "https://*.airbnb.gr/*",
    "https://*.airbnb.is/*",
    "https://*.airbnb.com.ee/*",
    "https://*.airbnb.com.tr/*",
    "https://*.airbnb.com.tw/*",
    "https://*.airbnb.com.ph/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.airbnb.com/*",
        "https://*.airbnb.co.uk/*",
        "https://*.airbnb.ca/*",
        "https://*.airbnb.fr/*",
        "https://*.airbnb.de/*",
        "https://*.airbnb.es/*",
        "https://*.airbnb.it/*",
        "https://*.airbnb.com.au/*",
        "https://*.airbnb.co.nz/*",
        "https://*.airbnb.com.sg/*",
        "https://*.airbnb.co.kr/*",
        "https://*.airbnb.co.jp/*",
        "https://*.airbnb.com.br/*",
        "https://*.airbnb.com.mx/*",
        "https://*.airbnb.ie/*",
        "https://*.airbnb.nl/*",
        "https://*.airbnb.com.hk/*",
        "https://*.airbnb.in/*",
        "https://*.airbnb.at/*",
        "https://*.airbnb.hu/*",
        "https://*.airbnb.cz/*",
        "https://*.airbnb.ch/*",
        "https://*.airbnb.pl/*",
        "https://*.airbnb.no/*",
        "https://*.airbnb.dk/*",
        "https://*.airbnb.pt/*",
        "https://*.airbnb.be/*",
        "https://*.airbnb.co.in/*",
        "https://*.airbnb.co.id/*",
        "https://*.airbnb.se/*",
        "https://*.airbnb.fi/*",
        "https://*.airbnb.co.za/*",
        "https://*.airbnb.lt/*",
        "https://*.airbnb.lv/*",
        "https://*.airbnb.rs/*",
        "https://*.airbnb.gr/*",
        "https://*.airbnb.is/*",
        "https://*.airbnb.com.ee/*",
        "https://*.airbnb.com.tr/*",
        "https://*.airbnb.com.tw/*",
        "https://*.airbnb.com.ph/*"
      ],
      "js": ["content/contentScript.js"],
      "css": ["content/contentStyles.css"],
      "run_at": "document_idle"
    }
  ]
}